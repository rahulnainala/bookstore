# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookstore
# Any long random string; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Only needed if the web app calls the API cross-origin (not needed with the Vite proxy / Vercel rewrite)
CORS_ORIGIN=
